project_id    = "my-gcp-project"
region        = "us-central1"
instance_name = "sql-enhanced-prod"

database_version       = "POSTGRES_16"
edition                = "ENTERPRISE_PLUS"
tier                   = "db-perf-optimized-N-2"
availability_type      = "REGIONAL"
disk_size_gb           = 100
deletion_protection    = true

vault_min_retention_duration = "7776000s"   # 90 days
vault_access_restriction     = "WITHIN_ORGANIZATION"

log_retention_days     = 14
daily_retention_days   = 30
weekly_retention_days  = 180
monthly_retention_days = 1825              # 5 years
schedule_time_zone     = "America/Toronto"

labels = {
  environment = "prod"
  owner       = "platform-data"
  compliance  = "pii"
}
